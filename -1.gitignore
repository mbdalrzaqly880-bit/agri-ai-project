# ملف .gitignore
# يخبر Git "لا ترفع هذي الملفات/المجلدات أبداً لـ GitHub"
# مهم جداً لحماية المفاتيح السرية وتجنب رفع ملفات مؤقتة غير ضرورية

# بيئة Python الافتراضية (كبيرة الحجم، ويعاد إنشاؤها بسهولة من requirements.txt)
venv/

# مفتاح Gemini API السري - **أهم سطر بالملف**
.env

# قاعدة البيانات المحلية (كل مطور/سيرفر يكون له نسخته الخاصة)
database/database.db

# ملفات بايثون المؤقتة
__pycache__/
*.pyc
